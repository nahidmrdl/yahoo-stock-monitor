{
  "name": "yahoo-stock-monitor",
  "version": "1.0.2",
  "description": "Yahoo Stock Monitor",
  "author": "nahidmrdl",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "package:win": "electron-builder --win portable",
    "package:mac": "electron-builder --mac dmg",
    "package:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.yahoostockmonitor",
    "productName": "Yahoo Stock Monitor",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app.ico",
      "artifactName": "Yahoo-Stock-Monitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "public/app.ico",
      "uninstallerIcon": "public/app.ico",
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yahoo Stock Monitor",
      "uninstallDisplayName": "Yahoo Stock Monitor"
    }
  }
}
